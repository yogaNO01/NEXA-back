MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nexa
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nexa_portal

# Required for administrator session signing. Username and password are used only
# to bootstrap the first database administrator when no admin_users exist.
NEXA_ADMIN_USERNAME=admin
NEXA_ADMIN_PASSWORD=replace-with-a-long-unique-password
NEXA_ADMIN_TOKEN_SECRET=replace-with-a-random-32-byte-or-longer-secret
NEXA_ADMIN_TOKEN_TTL_SECONDS=28800
NEXA_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://192.168.5.56:5175
# Optional: defaults to localhost and RFC1918 private-network origins on any port.
# NEXA_CORS_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|192\\.168(?:\\.\\d{1,3}){2})(?::\\d+)?$
