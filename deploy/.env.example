# Copy this file to .env on the server, then replace every placeholder.
MYSQL_DATABASE=nexa_portal
MYSQL_USER=nexa_app
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# Used only on the first startup, when the database has no administrator.
NEXA_ADMIN_USERNAME=admin
NEXA_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
NEXA_ADMIN_TOKEN_SECRET=replace-with-a-random-32-byte-or-longer-secret
NEXA_ADMIN_TOKEN_TTL_SECONDS=28800
